# ─────────────────────────────────────────────────────────────────
# XeroxExpress — Supabase configuration
#
# HOW TO FILL THESE IN:
#   1. Go to https://supabase.com and open your project
#   2. Click "Project Settings" (gear icon) → "API"
#   3. Copy "Project URL"  → paste as VITE_SUPABASE_URL below
#   4. Copy the key under "Project API keys" labelled
#      "publishable" (starts with sb_publishable_)
#      → paste as VITE_SUPABASE_PUBLISHABLE_KEY below
#   5. Save this file, then STOP and RESTART the dev server
#      (Ctrl+C, then npm run dev again) — Vite only reads .env on start
#
# DO NOT use the "service_role" secret key here — it is for
# server-side only and must never be in frontend code.
# ─────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://kojjiungmlmsohrhkfyp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kMaw5nDO_LcuKNJABoAuLg_Z9FlUD3N

# Server-side (SSR) copies — must match the VITE_ values above
SUPABASE_URL=https://kojjiungmlmsohrhkfyp.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_kMaw5nDO_LcuKNJABoAuLg_Z9FlUD3N
SUPABASE_PROJECT_ID=kojjiungmlmsohrhkfyp
